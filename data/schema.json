{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Habeas Protocol — Judgment Coding Schema v0.2",
  "description": "Per-judgment record schema. Supports both v0.1 (7-primitive) and v0.2 (6-primitive + 2 system) scoring layers. Every entry in judgments.json must validate against this. v0.2 is the active schema; v0.1 is retained for provenance on the original DIFC first-pass set.",
  "type": "object",
  "required": [
    "case_no",
    "url",
    "tribunal",
    "division",
    "date_issued",
    "parties",
    "judge",
    "claim_type",
    "primitive_scores_v02",
    "coding"
  ],
  "properties": {
    "case_no": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "tribunal": {
      "type": "string",
      "enum": ["DIFC Courts", "ADGM Courts", "Singapore International Commercial Court", "VARA", "Próspera Arbitration Center"]
    },
    "division": { "type": "string" },
    "date_issued": { "type": "string", "format": "date" },
    "parties": {
      "type": "object",
      "required": ["claimant", "defendant"],
      "properties": {
        "claimant": { "type": "string" },
        "defendant": { "type": "string" }
      }
    },
    "judge": { "type": "string" },
    "neutral_citation": { "type": "string" },
    "claim_type": {
      "type": "string",
      "enum": [
        "costs_assessment", "permission_to_appeal", "case_management",
        "summary_judgment", "interim_relief", "arbitration_recognition",
        "arbitration_enforcement", "default_judgment", "substantive_breach",
        "jurisdictional_challenge", "interpretation", "insolvency",
        "real_property", "anti_suit_injunction", "fraud", "other"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "claim_granted", "claim_partially_granted", "claim_dismissed",
        "application_refused", "settled", "discontinued", "other"
      ]
    },
    "operative_amount_aed": { "type": ["number", "null"] },
    "operative_amount_usd": { "type": ["number", "null"] },
    "rules_cited": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cases_cited": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Precedent cases cited in the ruling — supports the rule-bind primitive (PR3) where the binding instrument is case-law rather than statute."
    },
    "primitive_scores_v01": {
      "type": "object",
      "description": "7-primitive scoring (deprecated). Retained for provenance on original DIFC first-pass set.",
      "properties": {
        "P1": { "type": "integer", "enum": [0, 1, 2] },
        "P2": { "type": "integer", "enum": [0, 1, 2] },
        "P3": { "type": "integer", "enum": [0, 1, 2] },
        "P4": { "type": "integer", "enum": [0, 1, 2] },
        "P5": { "type": "integer", "enum": [0, 1, 2] },
        "P6": { "type": "integer", "enum": [0, 1, 2] },
        "P7": { "type": "integer", "enum": [0, 1, 2] }
      }
    },
    "primitive_scores_v02": {
      "type": "object",
      "description": "Six per-ruling primitives. The two system properties (SP1, SP2) are tribunal-level and recorded in primitives.json, not per-ruling.",
      "required": ["PR1", "PR2", "PR3", "PR4", "PR5", "PR6"],
      "properties": {
        "PR1": { "type": "integer", "enum": [0, 1, 2], "description": "Identity" },
        "PR2": { "type": "integer", "enum": [0, 1, 2], "description": "Evidence log" },
        "PR3": { "type": "integer", "enum": [0, 1, 2], "description": "Rule bind" },
        "PR4": { "type": "integer", "enum": [0, 1, 2], "description": "Procedure" },
        "PR5": { "type": "integer", "enum": [0, 1, 2], "description": "Ruling" },
        "PR6": { "type": "integer", "enum": [0, 1, 2], "description": "Enforcement bridge" }
      }
    },
    "coding": {
      "type": "object",
      "required": ["coder", "coded_on", "notes"],
      "properties": {
        "coder": {
          "type": "string",
          "description": "Procedure label, one of: 'MaximLabs (first-pass-claude)', 'MaximLabs (heuristic-triage)', 'MaximLabs (heuristic-graded)', 'MaximLabs (provisional-class-default)'."
        },
        "coded_on": { "type": "string", "format": "date" },
        "run_date": { "type": "string", "format": "date" },
        "first_pass": { "type": "boolean", "description": "True for the 39-entry LLM-graded first-pass set." },
        "gold_set": { "type": "boolean", "description": "Deprecated alias for first_pass; retained for backwards compatibility." },
        "grader_type": {
          "type": "string",
          "enum": ["llm", "regex_heuristic", "author_class_default"],
          "description": "Three grader types. 'llm': Claude Sonnet 4.5 read the judgment text and applied the rubric (first-pass set). 'regex_heuristic': deterministic Python script applied the rubric (heuristic-triage and heuristic-graded sets). 'author_class_default': author-assigned class-level default reflecting the published structural form of an instrument class — used for the falsification set and the peer-court comparison set; NOT a per-instance grading."
        },
        "model": { "type": "string", "description": "LLM model identifier (only for grader_type=llm)." },
        "temperature": { "type": "number" },
        "prompt_template_id": { "type": "string" },
        "system_prompt_sha256": { "type": "string" },
        "grader_script": { "type": "string", "description": "Producing-script path (only for grader_type=regex_heuristic)." },
        "scoring_basis": { "type": "string", "description": "Free-text description of how the class default was assigned (only for grader_type=author_class_default)." },
        "notes": { "type": "string" },
        "rationale": {
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        }
      }
    }
  }
}
