[
  {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Scope ADGMRecognition input",
    "description": "Input structure of scope ADGMRecognition",
    "$ref": "#/definitions/ADGMRecognition_in",
    "definitions": {
      "ADGMArbitrationGroundId": {
        "type": "string",
        "enum": [
          "S62_a_i_Incapacity", "S62_a_ii_InvalidAgreement",
          "S62_a_iii_NaturalJustice", "S62_a_iv_OutsideScope",
          "S62_a_v_TribunalComposition", "S62_a_vi_NotBindingOrSetAside",
          "S62_b_i_NotArbitrable", "S62_b_ii_PublicPolicy"
        ]
      },
      "ADGMGroundFinding": {
        "type": "object",
        "properties": {
          "ground": { "$ref": "#/definitions/ADGMArbitrationGroundId" },
          "court_outcome": { "$ref": "#/definitions/ADGMGroundOutcome" },
          "is_severable": { "type": "boolean" }
        },
        "required": [ "court_outcome", "ground", "is_severable" ],
        "additionalProperties": false
      },
      "ADGMGroundOutcome": {
        "type": "string",
        "enum": [ "Dismissed", "AllowedInPart", "AllowedInFull" ]
      },
      "ADGMRecognition_in": {
        "type": "object",
        "properties": {
          "grounds": {
            "type": "array",
            "items": { "$ref": "#/definitions/ADGMGroundFinding" }
          },
          "s58_was_or_could_have_been_available": { "type": "boolean" }
        },
        "required": [ "grounds", "s58_was_or_could_have_been_available" ],
        "additionalProperties": false
      }
    }
  },
  {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Scope ADGMRecognition output",
    "description": "Output structure of scope ADGMRecognition",
    "$ref": "#/definitions/ADGMRecognition",
    "definitions": {
      "ADGMRecognition": {
        "type": "object",
        "properties": {
          "disposition": { "$ref": "#/definitions/ADGMRefusalDisposition" }
        },
        "required": [ "disposition" ],
        "additionalProperties": false
      },
      "ADGMRecognitionDisposition": {
        "type": "string",
        "enum": [
          "RecognitionGranted", "RecognitionGrantedInPart",
          "RecognitionRefused"
        ]
      },
      "ADGMApplicationStatus": {
        "type": "string",
        "enum": [
          "ApplicationProperlyMade", "ApplicationBarredByS62_3"
        ]
      },
      "ADGMRefusalDisposition": {
        "type": "object",
        "properties": {
          "n_grounds_pleaded": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "n_grounds_dismissed": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "n_grounds_partial": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "n_grounds_full": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "overall_disposition": {
            "$ref": "#/definitions/ADGMRecognitionDisposition"
          },
          "award_recognised": { "type": "boolean" },
          "application_status": {
            "$ref": "#/definitions/ADGMApplicationStatus"
          }
        },
        "required": [
          "application_status",
          "award_recognised", "overall_disposition", "n_grounds_full",
          "n_grounds_partial", "n_grounds_dismissed", "n_grounds_pleaded"
        ],
        "additionalProperties": false
      }
    }
  }
]
