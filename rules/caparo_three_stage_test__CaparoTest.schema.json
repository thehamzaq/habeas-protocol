[
  {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Scope CaparoTest input",
    "description": "Input structure of scope CaparoTest",
    "$ref": "#/definitions/CaparoTest_in",
    "definitions": {
      "CaparoFacts": {
        "type": "object",
        "properties": {
          "is_established_category": { "type": "boolean" },
          "harm_reasonably_foreseeable": { "type": "boolean" },
          "sufficient_proximity": { "type": "boolean" },
          "fair_just_reasonable_to_impose": { "type": "boolean" }
        },
        "required": [
          "fair_just_reasonable_to_impose", "sufficient_proximity",
          "harm_reasonably_foreseeable", "is_established_category"
        ],
        "additionalProperties": false
      },
      "CaparoTest_in": {
        "type": "object",
        "properties": { "facts": { "$ref": "#/definitions/CaparoFacts" } },
        "required": [ "facts" ],
        "additionalProperties": false
      }
    }
  },
  {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Scope CaparoTest output",
    "description": "Output structure of scope CaparoTest",
    "$ref": "#/definitions/CaparoTest",
    "definitions": {
      "CaparoTest": {
        "type": "object",
        "properties": {
          "disposition": { "$ref": "#/definitions/DutyOfCareDisposition" }
        },
        "required": [ "disposition" ],
        "additionalProperties": false
      },
      "CaparoPath": {
        "type": "string",
        "enum": [
          "EstablishedCategory_DutyByPrecedent",
          "NovelCategory_AllStagesMade",
          "NovelCategory_FailsAtStage"
        ]
      },
      "CaparoStage": {
        "type": "string",
        "enum": [
          "Stage_None",
          "Stage_1_Foreseeability",
          "Stage_2_Proximity",
          "Stage_3_FairJustReasonable"
        ]
      },
      "DutyOfCareDisposition": {
        "type": "object",
        "properties": {
          "path": { "$ref": "#/definitions/CaparoPath" },
          "n_stages_satisfied": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "first_failing_stage": { "$ref": "#/definitions/CaparoStage" },
          "duty_of_care_owed": { "type": "boolean" }
        },
        "required": [
          "duty_of_care_owed", "first_failing_stage",
          "n_stages_satisfied", "path"
        ],
        "additionalProperties": false
      }
    }
  }
]
