## DIFC Norwich Pharmacal + Bankers Trust + RDC 28.52 — third-party
## disclosure jurisdiction
##
## Source:
##   - DIFC Courts Law (Law No. 2 of 2025), Articles 15(1) and 24(D).
##   - DIFC Law of Damages and Remedies (Law No. 7 of 2005), Article 36.
##   - Rules of the DIFC Courts (RDC) 25.1(10), 28.51 and 28.52.
##   - *Norwich Pharmacal Co v Customs and Excise Commissioners*
##     [1974] AC 133 (HL).
##   - *Bankers Trust Co v Shapira* [1980] 1 WLR 1274 (CA).
##
## The rule of decision for issuing a disclosure order against a
## non-party financial institution. Three independent jurisdictional
## gates are conjunctive over their own elements; ALL three must be
## made out for the Court to reach over to the non-party.
##
## Used in:
##   trace-07 — DEC 001/2025 *Techteryx Ltd v IG Limited* (DIFC
##              Digital Economy Court, Black KC, 3 April 2026).
##
## This module is the deterministic predicate core; the trace-07 rule
## file embeds the same core inline alongside the case-specific test
## scope. They are kept in sync; the rule module is what the simulator
## consumes.

```catala
declaration enumeration NorwichPharmacalElement:
  -- NPE_WrongEstablished
  -- NPE_RespondentMixedUp
  -- NPE_PossessesInformation
  -- NPE_DisclosureNecessaryInInterestsOfJustice

declaration enumeration BankersTrustElement:
  -- BTE_TracingClaimAsserted
  -- BTE_HoldsTraceableProceeds
  -- BTE_DisclosureNecessaryForTracing

declaration enumeration RDC2852Condition:
  -- RDC_LikelyToSupportOrAffect
  -- RDC_NecessaryToDisposeOrSaveCosts

declaration structure NPFinding:
  data element content NorwichPharmacalElement
  data made_out content boolean

declaration structure BTFinding:
  data element content BankersTrustElement
  data made_out content boolean

declaration structure RDCFinding:
  data rdc_condition content RDC2852Condition
  data made_out content boolean

declaration structure DisclosureGates:
  data nph_made_out content boolean
  data bankers_trust_made_out content boolean
  data rdc_2852_made_out content boolean
  data all_gates_satisfied content boolean
  data order_grantable content boolean

declaration scope ThirdPartyDisclosureGates:
  input nph_findings content list of NPFinding
  input bt_findings content list of BTFinding
  input rdc_findings content list of RDCFinding
  output gates content DisclosureGates

scope ThirdPartyDisclosureGates:
  definition gates equals
    let nph equals
      (number of (list of f among nph_findings
                  such that not f.made_out)) = 0
    in
    let bt equals
      (number of (list of f among bt_findings
                  such that not f.made_out)) = 0
    in
    let rdc equals
      (number of (list of f among rdc_findings
                  such that not f.made_out)) = 0
    in
    let all_gates equals nph and bt and rdc in
    DisclosureGates {
      -- nph_made_out: nph
      -- bankers_trust_made_out: bt
      -- rdc_2852_made_out: rdc
      -- all_gates_satisfied: all_gates
      -- order_grantable: all_gates
    }
```

## Tests — granted, refused on missing element.

```catala
#[test] declaration scope TestThirdPartyDisclosureGranted:
  composite scope ThirdPartyDisclosureGates
  output gates content DisclosureGates

scope TestThirdPartyDisclosureGranted:
  definition gates equals composite.gates
  ## Trace-07 facts: every element of every gate made out.
  definition composite.nph_findings equals [
    NPFinding { -- element: NPE_WrongEstablished                       -- made_out: true };
    NPFinding { -- element: NPE_RespondentMixedUp                      -- made_out: true };
    NPFinding { -- element: NPE_PossessesInformation                   -- made_out: true };
    NPFinding { -- element: NPE_DisclosureNecessaryInInterestsOfJustice -- made_out: true }
  ]
  definition composite.bt_findings equals [
    BTFinding { -- element: BTE_TracingClaimAsserted        -- made_out: true };
    BTFinding { -- element: BTE_HoldsTraceableProceeds      -- made_out: true };
    BTFinding { -- element: BTE_DisclosureNecessaryForTracing -- made_out: true }
  ]
  definition composite.rdc_findings equals [
    RDCFinding { -- rdc_condition: RDC_LikelyToSupportOrAffect       -- made_out: true };
    RDCFinding { -- rdc_condition: RDC_NecessaryToDisposeOrSaveCosts -- made_out: true }
  ]
  assertion gates.order_grantable = true

#[test] declaration scope TestThirdPartyDisclosureRefused:
  composite scope ThirdPartyDisclosureGates
  output gates content DisclosureGates

scope TestThirdPartyDisclosureRefused:
  definition gates equals composite.gates
  ## A single missing Norwich Pharmacal element is dispositive — the
  ## Court has no jurisdiction to make the order.
  definition composite.nph_findings equals [
    NPFinding { -- element: NPE_WrongEstablished                       -- made_out: true };
    NPFinding { -- element: NPE_RespondentMixedUp                      -- made_out: false };
    NPFinding { -- element: NPE_PossessesInformation                   -- made_out: true };
    NPFinding { -- element: NPE_DisclosureNecessaryInInterestsOfJustice -- made_out: true }
  ]
  definition composite.bt_findings equals [
    BTFinding { -- element: BTE_TracingClaimAsserted        -- made_out: true };
    BTFinding { -- element: BTE_HoldsTraceableProceeds      -- made_out: true };
    BTFinding { -- element: BTE_DisclosureNecessaryForTracing -- made_out: true }
  ]
  definition composite.rdc_findings equals [
    RDCFinding { -- rdc_condition: RDC_LikelyToSupportOrAffect       -- made_out: true };
    RDCFinding { -- rdc_condition: RDC_NecessaryToDisposeOrSaveCosts -- made_out: true }
  ]
  assertion gates.order_grantable = false
  assertion gates.nph_made_out = false
```
