[
  {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Scope ThirdPartyDisclosureGates input",
    "description": "Input structure of scope ThirdPartyDisclosureGates",
    "$ref": "#/definitions/ThirdPartyDisclosureGates_in",
    "definitions": {
      "BTFinding": {
        "type": "object",
        "properties": {
          "element": { "$ref": "#/definitions/BankersTrustElement" },
          "made_out": { "type": "boolean" }
        },
        "required": [ "made_out", "element" ],
        "additionalProperties": false
      },
      "BankersTrustElement": {
        "type": "string",
        "enum": [
          "BTE_TracingClaimAsserted", "BTE_HoldsTraceableProceeds",
          "BTE_DisclosureNecessaryForTracing"
        ]
      },
      "NPFinding": {
        "type": "object",
        "properties": {
          "element": { "$ref": "#/definitions/NorwichPharmacalElement" },
          "made_out": { "type": "boolean" }
        },
        "required": [ "made_out", "element" ],
        "additionalProperties": false
      },
      "NorwichPharmacalElement": {
        "type": "string",
        "enum": [
          "NPE_WrongEstablished", "NPE_RespondentMixedUp",
          "NPE_PossessesInformation",
          "NPE_DisclosureNecessaryInInterestsOfJustice"
        ]
      },
      "RDC2852Condition": {
        "type": "string",
        "enum": [
          "RDC_LikelyToSupportOrAffect", "RDC_NecessaryToDisposeOrSaveCosts"
        ]
      },
      "RDCFinding": {
        "type": "object",
        "properties": {
          "rdc_condition": { "$ref": "#/definitions/RDC2852Condition" },
          "made_out": { "type": "boolean" }
        },
        "required": [ "made_out", "rdc_condition" ],
        "additionalProperties": false
      },
      "ThirdPartyDisclosureGates_in": {
        "type": "object",
        "properties": {
          "nph_findings": {
            "type": "array",
            "items": { "$ref": "#/definitions/NPFinding" }
          },
          "bt_findings": {
            "type": "array",
            "items": { "$ref": "#/definitions/BTFinding" }
          },
          "rdc_findings": {
            "type": "array",
            "items": { "$ref": "#/definitions/RDCFinding" }
          }
        },
        "required": [ "rdc_findings", "bt_findings", "nph_findings" ],
        "additionalProperties": false
      }
    }
  },
  {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Scope ThirdPartyDisclosureGates output",
    "description": "Output structure of scope ThirdPartyDisclosureGates",
    "$ref": "#/definitions/ThirdPartyDisclosureGates",
    "definitions": {
      "DisclosureGates": {
        "type": "object",
        "properties": {
          "nph_made_out": { "type": "boolean" },
          "bankers_trust_made_out": { "type": "boolean" },
          "rdc_2852_made_out": { "type": "boolean" },
          "all_gates_satisfied": { "type": "boolean" },
          "order_grantable": { "type": "boolean" }
        },
        "required": [
          "order_grantable", "all_gates_satisfied", "rdc_2852_made_out",
          "bankers_trust_made_out", "nph_made_out"
        ],
        "additionalProperties": false
      },
      "ThirdPartyDisclosureGates": {
        "type": "object",
        "properties": {
          "gates": { "$ref": "#/definitions/DisclosureGates" }
        },
        "required": [ "gates" ],
        "additionalProperties": false
      }
    }
  }
]
