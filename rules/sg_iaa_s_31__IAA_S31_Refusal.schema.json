[
  {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Scope IAA_S31_Refusal input",
    "description": "Input structure of scope IAA_S31_Refusal",
    "$ref": "#/definitions/IAA_S31_Refusal_in",
    "definitions": {
      "GroundFinding": {
        "type": "object",
        "properties": {
          "ground": { "$ref": "#/definitions/IAAGroundId" },
          "court_outcome": { "$ref": "#/definitions/GroundOutcome" },
          "is_severable": { "type": "boolean" }
        },
        "required": [ "court_outcome", "ground", "is_severable" ],
        "additionalProperties": false
      },
      "GroundOutcome": {
        "type": "string",
        "enum": [ "Dismissed", "AllowedInPart", "AllowedInFull" ]
      },
      "IAAGroundId": {
        "type": "string",
        "enum": [
          "S31_2_a_Incapacity", "S31_2_b_InvalidAgreement",
          "S31_2_c_NaturalJustice", "S31_2_d_OutsideScope",
          "S31_2_e_TribunalComposition", "S31_2_f_NotBindingOrSetAside",
          "S31_4_a_NotArbitrable", "S31_4_b_PublicPolicy"
        ]
      },
      "IAA_S31_Refusal_in": {
        "type": "object",
        "properties": {
          "grounds": {
            "type": "array",
            "items": { "$ref": "#/definitions/GroundFinding" }
          }
        },
        "required": [ "grounds" ],
        "additionalProperties": false
      }
    }
  },
  {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Scope IAA_S31_Refusal output",
    "description": "Output structure of scope IAA_S31_Refusal",
    "$ref": "#/definitions/IAA_S31_Refusal",
    "definitions": {
      "ApplicationDisposition": {
        "type": "string",
        "enum": [
          "ApplicationDismissedEntirely", "ApplicationAllowedInPart",
          "AwardSetAside"
        ]
      },
      "IAA_S31_Refusal": {
        "type": "object",
        "properties": {
          "disposition": { "$ref": "#/definitions/RefusalDisposition" }
        },
        "required": [ "disposition" ],
        "additionalProperties": false
      },
      "RefusalDisposition": {
        "type": "object",
        "properties": {
          "n_grounds_pleaded": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "n_grounds_dismissed": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "n_grounds_partial": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "n_grounds_full": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": -9007199254740992.0,
                "maximum": 9007199254740992.0
              },
              { "type": "string" }
            ]
          },
          "application_disposition": {
            "$ref": "#/definitions/ApplicationDisposition"
          },
          "award_enforced": { "type": "boolean" }
        },
        "required": [
          "award_enforced", "application_disposition", "n_grounds_full",
          "n_grounds_partial", "n_grounds_dismissed", "n_grounds_pleaded"
        ],
        "additionalProperties": false
      }
    }
  }
]
