## Rule of the Court (Substantive contract dispute — composition of findings)
##
## Source: UAE Civil Transactions Law Article 390 (liquidated damages cap and
## judicial variation) + ADGM Court Procedure Rules 2016 Rule 42 (admissions)
## + ADGM Civil Evidence, Judgments, Enforcement and Judicial Appointments
## Regulations 2015 §§ 181, 182 (set-off of claims and counterclaims).
##
## This file expresses the rule applied in:
##   ADGMCFI-2024-320 — Projeco Contracting (L.L.C) v Ideacrate Edutainment
##   Company L.L.C — O.P.C
##   Order with Reasons of H.E. Justice Paul Heath KC, 30 October 2025.
##
## Trace #4 is the substantive-contract case: the rule is doctrinal at the
## input layer (the judge must determine whether delay was caused, whether
## handover constituted substantial completion, whether each counterclaim
## item is proven on the balance of probabilities, etc.) but the rule is
## arithmetic at the composition layer. Once the human-judgment inputs
## are fixed, the answer composes deterministically:
##
##   1. Liquidated damages = min(daily_rate * days_of_critical_delay,
##                               cap_pct * adjusted_contract_price)
##   2. Counterclaim sum   = sum of proven counterclaim items
##   3. Net balance        = withheld_amount - counterclaim_sum
##                            (payable to claimant if positive)
##   4. Pre-judgment interest = principal * rate * days_to_judgment / 365
##   5. Total judgment        = principal + interest
##
## This is structurally distinct from Traces #1-#3:
##   #1 (formula)            — pure arithmetic, no human inputs
##   #2 (deferred conditional) — temporal predicate over a fixed rule
##   #3 (bounded discretion) — rule strips a filter; residue is the answer
##   #4 (composition over findings) — rule is arithmetic over multiple
##                                    substantive determinations; the
##                                    protocol composes them
##
## The constructive claim of Trace #4 is that even on a fully substantive
## contract dispute — the kind of case the original Maxim brief proposed
## to handle by ad-hoc arbitration — the rule decomposes cleanly into
## (i) substantive determinations made by a judge and (ii) arithmetic
## composition the protocol can verify.
##
## Catala 1.1.0 notes:
##   - Counterclaim labels encoded as enumeration (no `text` primitive).
##   - List comprehension `[x for o among lst if cond]` replaced with
##     `map each o among lst such that cond to x`.
##   - Date subtraction returns a `duration`; `(d1 - d2) / 1 day` gives
##     decimal number of calendar days between them.
##   - `decimal of n` converts integer to decimal where required.

```catala
declaration enumeration CounterclaimItemId:
  -- RemediationAndRepair
  -- SmokeManagementSystemContribution

declaration structure CounterclaimItem:
  data item content CounterclaimItemId
  data amount_aed content decimal
  data found_proven content boolean

declaration structure ContractFacts:
  data adjusted_contract_price_aed content decimal
  data ld_cap_pct content decimal
  data daily_ld_rate_aed content decimal
  data days_of_critical_delay_found content integer
  data counterclaim_items content list of CounterclaimItem
  data amount_withheld_by_defendant_aed content decimal
  data handover_date content date
  data judgment_date content date
  data interest_rate_pa content decimal

declaration structure Disposition:
  data ld_uncapped_aed content decimal
  data ld_cap_aed content decimal
  data ld_awarded_aed content decimal
  data ld_was_capped content boolean
  ## Defendant's proven counterclaim items only — i.e. the sum of
  ## items in the input list. The CALLER is responsible for excluding
  ## the claimant's own LD line from `counterclaim_items` (the trace
  ## evaluator marks the LD line with `computed_from_rule=true`; the
  ## Catala scope receives only the *real* defendant counterclaim).
  ## If the caller mistakenly passes LD inside counterclaim_items,
  ## `total_offsets_aed` will double-count.
  data defendant_counterclaim_aed content decimal
  ## Combined offsets against the claimant's withheld funds: the
  ## defendant's proven counterclaim plus the claimant's own LD
  ## entitlement (which the defendant has already paid by withholding).
  ## Renamed from `counterclaim_sum_aed` (the prior name conflated the
  ## two and was flagged in the 2026-05-05 audit).
  data total_offsets_aed content decimal
  data net_to_claimant_aed content decimal
  data days_to_judgment content decimal
  data interest_aed content decimal
  data total_judgment_aed content decimal

declaration scope CompositeJudgment:
  input facts content ContractFacts
  output disposition content Disposition

scope CompositeJudgment:
  definition disposition equals
    let ld_uncapped equals
      facts.daily_ld_rate_aed * (decimal of facts.days_of_critical_delay_found)
    in
    let ld_cap equals
      facts.adjusted_contract_price_aed * facts.ld_cap_pct
    in
    let ld_awarded equals
      if ld_uncapped > ld_cap then ld_cap else ld_uncapped
    in
    let ld_was_capped equals ld_uncapped > ld_cap in
    let defendant_counterclaim equals
      sum decimal of (map each item among facts.counterclaim_items
                      such that item.found_proven
                      to item.amount_aed)
    in
    let total_offsets equals
      defendant_counterclaim
      + (if ld_awarded > 0.0 then ld_awarded else 0.0)
    in
    let net equals
      facts.amount_withheld_by_defendant_aed - total_offsets
    in
    let days equals
      (facts.judgment_date - facts.handover_date) / 1 day
    in
    let interest equals
      net * facts.interest_rate_pa * (days / 365.0)
    in
    Disposition {
      -- ld_uncapped_aed: ld_uncapped
      -- ld_cap_aed: ld_cap
      -- ld_awarded_aed: ld_awarded
      -- ld_was_capped: ld_was_capped
      -- defendant_counterclaim_aed: defendant_counterclaim
      -- total_offsets_aed: total_offsets
      -- net_to_claimant_aed: net
      -- days_to_judgment: days
      -- interest_aed: interest
      -- total_judgment_aed: net + interest
    }
```

## Test — facts of ADGMCFI-2024-320

```catala
#[test] declaration scope TestProjeco:
  composite scope CompositeJudgment
  output disposition content Disposition

scope TestProjeco:
  definition composite.facts equals ContractFacts {
    -- adjusted_contract_price_aed: 6085211.90
    -- ld_cap_pct: 0.10
    -- daily_ld_rate_aed: 100000.0
    -- days_of_critical_delay_found: 97
    -- counterclaim_items: [
      CounterclaimItem {
        -- item: RemediationAndRepair
        -- amount_aed: 55336.0
        -- found_proven: false
      };
      CounterclaimItem {
        -- item: SmokeManagementSystemContribution
        -- amount_aed: 147265.0
        -- found_proven: true
      }
    ]
    -- amount_withheld_by_defendant_aed: 766287.15
    -- handover_date: |2024-02-29|
    -- judgment_date: |2025-10-30|
    -- interest_rate_pa: 0.05
  }

  definition disposition equals composite.disposition

  ## Court awarded LDs at the cap of AED 608,521.19
  assertion disposition.ld_was_capped = true
  assertion disposition.ld_awarded_aed = 608521.19
  ## Defendant's proven counterclaim items (smoke management only,
  ## remediation not proven) sum to AED 147,265.00. The Catala scope
  ## input excludes the LD line (per the docstring contract); LD is
  ## added separately to total_offsets via ld_awarded.
  assertion disposition.defendant_counterclaim_aed = 147265.00
  ## Total offsets (defendant counterclaim + LD) sum to AED 755,786.19
  assertion disposition.total_offsets_aed = 755786.19
  ## Court found net principal AED 10,500.96
  assertion disposition.net_to_claimant_aed = 10500.96
```
